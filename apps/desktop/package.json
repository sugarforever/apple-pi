{
  "name": "@apple-pi/desktop",
  "productName": "Apple Pi Lite",
  "version": "0.7.0",
  "private": true,
  "homepage": "https://github.com/sugarforever/apple-pi",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test scripts/*.test.mjs && vitest run --exclude=scripts/*.test.mjs --exclude=src/main/*-package.test.ts",
    "fixtures:generate": "pnpm build && node scripts/generate-visual-fixtures.mjs",
    "test:package": "pnpm build && vitest run src/main/preload-package.test.ts",
    "test:mac-package-launch": "node scripts/verify-macos-app-launch.mjs",
    "test:packaged-pi": "node scripts/verify-packaged-pi.mjs",
    "package:mac": "pnpm build && APPLE_PI_ADHOC_RESIGN=1 CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "package:mac:signed": "pnpm build && electron-builder --mac --config.mac.notarize=true --publish never",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never",
    "package:linux": "pnpm build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "electron-updater": "6.8.9",
    "highlight.js": "11.12.0",
    "lucide-react": "^0.525.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "39.8.2",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "build": {
    "appId": "ai.applepi.lite",
    "afterSign": "scripts/resign-macos-adhoc.mjs",
    "publish": [
      {
        "provider": "github",
        "owner": "sugarforever",
        "repo": "apple-pi",
        "channel": "lite"
      }
    ],
    "extraMetadata": {
      "name": "apple-pi-lite"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "apple-pi-lite-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "apple-pi-lite-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "apple-pi-lite-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "sugarforever"
    },
    "appImage": {
      "artifactName": "apple-pi-lite-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "apple-pi-lite-${version}-linux-x64.${ext}"
    }
  }
}
