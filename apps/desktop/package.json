{
  "name": "@apple-pi/desktop",
  "version": "0.2.0",
  "private": true,
  "homepage": "https://github.com/sugarforever/apple-pi",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @apple-pi/protocol build && pnpm --filter @apple-pi/pi-adapter build && pnpm --filter @apple-pi/agent-host build && electron-vite dev",
    "build": "pnpm --filter @apple-pi/agent-host build && electron-vite build && node scripts/stage-agent-host.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test scripts/*.test.mjs && vitest run --exclude=scripts/*.test.mjs",
    "test:package": "pnpm build && vitest run src/main/agent-host-package.test.ts",
    "package:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "package:mac:signed": "pnpm build && electron-builder --mac --config.mac.notarize=true --publish never",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never",
    "package:linux": "pnpm build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@apple-pi/agent-host": "workspace:*",
    "@apple-pi/pi-adapter": "workspace:*",
    "@apple-pi/protocol": "workspace:*",
    "lucide-react": "^0.525.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "39.8.2",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "build": {
    "appId": "works.earendil.applepi",
    "productName": "Apple Pi",
    "directories": {
      "output": "release"
    },
    "artifactName": "apple-pi-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "apple-pi-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "apple-pi-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "sugarforever"
    },
    "appImage": {
      "artifactName": "apple-pi-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "apple-pi-${version}-linux-x64.${ext}"
    }
  }
}
