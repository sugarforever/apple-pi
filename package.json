{
  "name": "apple-pi",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": ">=22.20.0" },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @apple-pi/desktop dev",
    "build": "pnpm -r build",
    "docs:check": "node scripts/check-doc-links.mjs",
    "typecheck": "pnpm --filter @apple-pi/protocol build && pnpm --filter @apple-pi/pi-adapter build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:pi-compatibility": "pnpm --filter @apple-pi/protocol build && pnpm --filter @apple-pi/pi-adapter exec vitest run src/compatibility.test.ts",
    "test:host-smoke": "pnpm --filter @apple-pi/protocol build && pnpm --filter @apple-pi/pi-adapter build && pnpm --filter @apple-pi/desktop test:package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "package:mac": "pnpm --filter @apple-pi/desktop package:mac",
    "package:win": "pnpm --filter @apple-pi/desktop package:win",
    "package:linux": "pnpm --filter @apple-pi/desktop package:linux",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.0.18"
  }
}
