# Repo standard: exact dependency versions and an enforced Node engine.
save-exact=true
engine-strict=true

# pnpm's default isolated node_modules works for this repo because every
# workspace package that ships to users is either bundled by Vite/Rollup
# (renderer, main, preload) or resolved from an explicit production
# dependency (agent-host). If `electron-builder` ever reports missing
# modules while packaging, switch to the layout it expects with:
#   node-linker=hoisted
